# ID da pasta raiz no Google Drive
DRIVE_ROOT_FOLDER_ID=1mTF-qVaUEurosSl6Jy4VkOBbmRcNYL4O

# Modo de autenticação Drive: oauth | service_account
GOOGLE_DRIVE_AUTH_MODE=service_account

# Caminho para JSON de Service Account (recomendado para Cloud)
GOOGLE_SERVICE_ACCOUNT_FILE=/Users/lucas/Downloads/GINECOLOGIA - AFYA/aula-pipeline/backend/credentials/service_account.json
# Alternativa para Cloud Run: conteúdo JSON completo da credencial
GOOGLE_SERVICE_ACCOUNT_JSON=

# Caminho para o OAuth client JSON baixado do Google Cloud
GOOGLE_OAUTH_CLIENT_SECRET=/Users/lucas/Downloads/GINECOLOGIA - AFYA/aula-pipeline/backend/credentials/oauth_client.json

# Caminho onde o token OAuth será salvo após autorização
GOOGLE_OAUTH_TOKEN_PATH=/Users/lucas/Downloads/GINECOLOGIA - AFYA/aula-pipeline/backend/credentials/token.json

# Origens permitidas no frontend
ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,https://lucaserbano.github.io

# Desative em produção/cloud: 0
OPEN_FOLDER_ACTION_ENABLED=1

# IA no backend (OpenRouter)
ENABLE_AI_ACTIONS=0
AI_BACKEND=vertex
AI_TIMEOUT_SECONDS=90

# Vertex AI (recomendado)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# OpenRouter (opcional/fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=https://lucaserbano.github.io/ginecologia/
OPENROUTER_APP_TITLE=Gineco Kanban
